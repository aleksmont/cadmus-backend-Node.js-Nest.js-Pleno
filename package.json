{
  "name": "cadmus-sincronizacao-contas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Núcleo de sincronização de lançamentos para o teste técnico backend",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.spec.js",
    "test:integracao": "npm run build && node --test dist/test/*.integration.js",
    "check": "npm test && npm run test:integracao"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
